# ===== LLM PROVIDER API KEYS =====
# These are REQUIRED and should be kept secret. Do not share these values.
OPENAI_API_KEY=sk-...  # 🔒 Must be a real OpenAI API key (e.g., sk-proj-...)

# Anthropic API key (OPTIONAL - falls back to OpenAI gpt-4o-mini if not set)
ANTHROPIC_API_KEY=sk-ant-...  # 🔒 optional - for claude-opus-4-8 if available

# ===== QDRANT VECTOR DATABASE =====
# Qdrant Cloud cluster URL
QDRANT_URL=https://your-cluster.cloud.qdrant.io

# Qdrant API key (for authentication)
QDRANT_API_KEY=your-qdrant-key

# ===== IMPORTANCE =====
# ⚠️  Do NOT commit any files containing real API keys to version control.
#     The .gitignore above automatically excludes .env, .env.local, *.key, *_api_key.txt, etc.
#     Anyone who commits secrets will have their API accounts compromised.
#     See: .gitignore and .streamlit/secrets.toml.example
